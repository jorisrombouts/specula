# Specula environment. Copy to .env and fill in. New vars are added per milestone.
APP_ENV=development

# Postgres (local docker via `just up`). Async driver form for SQLAlchemy/asyncpg.
# Host port 55432 avoids collision with any system Postgres on the default 5432.
# Connect as the non-superuser `specula_app` role (created by db/init.sql) so RLS is
# actually enforced — the bootstrap `specula` superuser would bypass every policy.
# NOTE: db/init.sql only runs on a FRESH volume. If you have a pre-role-split dev DB,
# rebuild it: `just down && docker volume rm specula_specula_pgdata && just up`.
DATABASE_URL=postgresql+asyncpg://specula_app:specula@localhost:55432/specula
# Parallel M2 fan-out: each git worktree points DATABASE_URL at its own database on
# the same container (e.g. .../specula_wt_lenses), created via `just db-bootstrap`.

# Shared HS256 secret the Next BFF signs the short-lived service JWT with and FastAPI
# validates (must be identical on web + api). Generate with `openssl rand -hex 32`.
SERVICE_JWT_SECRET=
# Base URL of the FastAPI service the Next BFF calls (bffFetch). Defaults to
# http://localhost:8000 if unset.
API_URL=http://localhost:8000

# Auth.js (web). AUTH_SECRET signs the session JWT — generate with `npx auth secret`.
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET come from a Google Cloud OAuth client
# (provisioned later; sign-in only completes once these are real).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
