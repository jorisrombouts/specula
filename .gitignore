# Playwright
test-results/
playwright-report/
.last-run.json
apps/web/e2e/visual/.auth/
# Only the Linux pixel baselines are committed (they match CI); a local macOS/
# Windows run writes platform-specific snapshots that must never be committed.
*-darwin.png
*-win32.png

# Live-run page captures (PIPELINE_MODE=record -> RecordingFetcher): hundreds of MB of raw
# ATS/company HTML, keyed by sha256 of the REAL url. The suite replays its own small
# hand-authored "acme" fixtures instead — those are already tracked, and gitignore does not
# untrack, so they keep working. Add a new hand-authored one with `git add -f`.
# The openai/* recordings stay tracked: they're small and document real response shapes.
apps/api/tests/fixtures/pipeline/http/*.json

# Env & secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# Tooling
.pre-commit-cache/
.vscode/

# git worktrees for parallel M2 fan-out lanes
.worktrees/
